# Rails 8 on HPPLite, in a container (tests/real_apps/docker/rails.sh).
# Ruby 3.3 on the Debian the module is built for (trixie, so.sh), the
# runtime libraries the module links, the toolchain the sqlite3 gem's native
# extension needs, the rails gem, and the app generated by the same setup.sh
# a host run uses (two scaffolds and a Solid Queue job).
FROM ruby:3.3-trixie
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        libsecp256k1-2 libcurl4t64 zlib1g python3 build-essential libsqlite3-dev libyaml-dev ca-certificates curl sqlite3 \
    && rm -rf /var/lib/apt/lists/* \
    && gem install rails --no-document
COPY rails/setup.sh rails/order_job.rb rails/drive.py /suite/
RUN sh /suite/setup.sh /rails
WORKDIR /rails/shop
